# Copy to ~/.af/service.env, fill AF_SERVICE_SECRET, chmod 600. NEVER commit the real file.
AF_SERVICE_SECRET=          # openssl rand -hex 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AF_SERVICE_PORT=4150
AF_SERVICE_BIND=            # tailnet IPv4: tailscale ip -4   (fail-closed; never 0.0.0.0)
AF_SERVICE_DB=/home/vanara/.af/service.db
AF_MAX_CONCURRENCY=20
AF_MAX_QUEUE_DEPTH=500
AF_SERVICE_RETENTION_DAYS=0   # 0 = keep all audit history forever
